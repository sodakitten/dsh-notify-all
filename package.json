{
  "name": "dsh-notify-all",
  "description": "Native DSH desktop notifications and per-conversation Windows taskbar badges",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sodakitten/dsh-notify-all.git"
  },
  "homepage": "https://github.com/sodakitten/dsh-notify-all#readme",
  "bugs": {
    "url": "https://github.com/sodakitten/dsh-notify-all/issues"
  },
  "version": "0.2.2",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node tests/regression-test.mjs && node tests/session-menu-test.mjs",
    "test:native": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tests/native-regression.ps1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "icon": "./icon.svg"
}
